<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.vencordguard.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>__BINARY__</string>
        <string>run</string>
    </array>

    <!-- Start at login. There is no StartInterval and no WatchPaths: the agent arms its own
         kqueue watches and NSWorkspace observers, so launchd never needs to wake it. -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Aqua session: required for NSWorkspace application launch/terminate notifications. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>ProcessType</key>
    <string>Background</string>

    <!-- Never let a repair loop hog the machine. -->
    <key>Nice</key>
    <integer>5</integer>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__LOGDIR__/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGDIR__/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
